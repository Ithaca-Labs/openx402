# ---------------------------------------------------------------------------
# Split-out directories
#
# `main` carries the self-hostable services and the dashboard. Larger working
# and reference directories remain branch-local or untracked:
#
#   git checkout full-stack
#
#   brand/      brand kit and assets (also on `assets/brandkit`)
#   tasks/      internal working notes
#   reference/  external repo clones used while developing (~7.6 GB)
#
# These stay on disk when you switch back to `main`; they are simply untracked
# here. Nothing in facilitator/ or mcp-server/ imports them, and none of them
# are npm workspaces.
# ---------------------------------------------------------------------------
/brand/
/tasks/
/reference/

# Release judgments are a sealed holdout and must never enter normal tuning paths.
/facilitator/handwritten-evals/qrels/release-v2.jsonl
/facilitator/handwritten-evals/qrels/raw-agent-v2.jsonl
/facilitator/handwritten-evals/reports/calibration-raw-v2.jsonl
/facilitator/handwritten-evals/reports/calibration-v2.jsonl
/facilitator/handwritten-evals/reports/owner-review-full-v2.json
/facilitator/handwritten-evals/staging/query-pass1/imports/
/facilitator/handwritten-evals/staging/query-pass1/manifest.json
/facilitator/handwritten-evals/staging/query-pass1/raw-qrels.jsonl

# Derived embedding-vector cache for pool-build exact_dense/hybrid_exact runs.
# Regenerable from catalog/query text + model; only the resulting ranked run
# files under pool/ are the committed, hash-pinned artifact.
/facilitator/handwritten-evals/staging/embeddings/

# OS / editor
.DS_Store
*.swp

# Dependencies / build output
node_modules/
dist/
target/
.next/

# Local environment
.env
.env.*
!.env.example
/deploy/railway/template-variables.env

# Example apps pull their own dependencies
/examples/*/node_modules/
