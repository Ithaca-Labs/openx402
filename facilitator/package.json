{
  "name": "@openx402/stellar-facilitator",
  "version": "0.1.0",
  "description": "Self-hostable Stellar x402 facilitator with an embeddable resource-server client",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/embedded.js",
  "types": "./dist/src/embedded.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/embedded.d.ts",
      "import": "./dist/src/embedded.js"
    },
    "./embedded": {
      "types": "./dist/src/embedded.d.ts",
      "import": "./dist/src/embedded.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "migrations",
    "config",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:sdk && npm run build:service",
    "build:sdk": "npm run build --prefix ../packages/bazaar-sdk",
    "build:service": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/cli/migrate.ts",
    "keys": "tsx src/cli/keys.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:live": "tsx tests/live/testnet.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "licenses": "node scripts/check-licenses.mjs",
    "test:sdk": "npm test --prefix ../packages/bazaar-sdk",
    "evaluate": "tsx src/cli/evaluate.ts",
    "benchmark:run": "tsx src/cli/run-benchmark.ts",
    "benchmark:fetch-cdp": "tsx src/cli/fetch-cdp-benchmark.ts",
    "benchmark:fetch-ecosystem": "tsx src/cli/fetch-ecosystem.ts",
    "benchmark:probe-ecosystem": "tsx src/cli/probe-ecosystem.ts",
    "benchmark:seed-ecosystem-queries": "tsx src/cli/seed-ecosystem-queries.ts",
    "benchmark:import-ecosystem": "tsx src/cli/import-ecosystem-artifact.ts",
    "benchmark:validate-ecosystem": "tsx src/cli/validate-ecosystem.ts",
    "benchmark:evaluate-ecosystem": "tsx src/cli/evaluate-ecosystem.ts",
    "benchmark:generate": "tsx src/cli/generate-release-dataset.ts",
    "benchmark:generate-candidates": "tsx src/cli/generate-openrouter-candidates.ts",
    "benchmark:curate-no-results": "tsx src/cli/curate-no-result-qrels.ts",
    "benchmark:calibration": "tsx src/cli/calibration-report.ts",
    "benchmark:import-human": "tsx src/cli/import-human-calibration.ts",
    "benchmark:validate": "tsx src/cli/validate-release-dataset.ts",
    "benchmark:evaluate": "tsx src/cli/evaluate-release.ts",
    "benchmark:model-report": "tsx src/cli/report-bge-m3.ts",
    "benchmark:gates": "tsx src/cli/release-gates.ts",
    "benchmark:v2:status": "tsx handwritten-evals/tools/release-gates-v2.ts --report-only",
    "benchmark:v2:gates": "tsx handwritten-evals/tools/release-gates-v2.ts",
    "benchmark:v2:development-ci": "tsx handwritten-evals/tools/development-ci-v2.ts",
    "index": "tsx src/cli/index-search.ts",
    "test:live-model": "vitest run --config vitest.live-model.config.ts"
  },
  "dependencies": {
    "@openx402/bazaar-sdk": "file:../packages/bazaar-sdk",
    "@stellar/stellar-sdk": "16.2.0",
    "@x402/core": "2.20.0",
    "@x402/extensions": "^2.20.0",
    "@x402/stellar": "2.20.0",
    "ajv": "^8.20.0",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@openx402/stellar-upto": "file:../packages/stellar-upto",
    "@types/express": "5.0.3",
    "@types/node": "24.2.0",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
