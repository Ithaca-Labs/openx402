{
  "name": "@openx402/stellar-facilitator",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build -w @openx402/bazaar-sdk",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/cli/migrate.ts",
    "keys": "tsx src/cli/keys.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:live": "tsx tests/live/testnet.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "licenses": "node scripts/check-licenses.mjs",
    "test:sdk": "vitest run packages",
    "evaluate": "tsx src/cli/evaluate.ts",
    "index": "tsx src/cli/index-search.ts",
    "test:live-model": "vitest run --config vitest.live-model.config.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.2.0",
    "@x402/core": "2.20.0",
    "@x402/extensions": "^2.20.0",
    "@x402/stellar": "2.20.0",
    "ajv": "^8.20.0",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.2.0",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
