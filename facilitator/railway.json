{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "facilitator/Dockerfile",
    "watchPatterns": [
      "/facilitator/**",
      "/packages/bazaar-sdk/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false
  }
}
