# Server-only facilitator URL. Required for the hosted Vercel dashboard.
FACILITATOR_URL=https://facilitator-production-8430.up.railway.app

# Optional bearer token for protected facilitator deployments.
FACILITATOR_API_KEY=

# Optional private service URL for colocated/self-hosted deployments. When set,
# it takes precedence over FACILITATOR_URL and must never be exposed to clients.
FACILITATOR_INTERNAL_URL=

# Server-only Postgres connection used exclusively by the frontend analytics routes.
ANALYTICS_DATABASE_URL=
