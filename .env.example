# openx402 self-hosted configuration
#
#   cp .env.example .env
#
# Only the two REQUIRED values below need changing to get a working stack.
# Everything else is optional and documented inline.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Database password. Any strong random string.
#   openssl rand -hex 16
POSTGRES_PASSWORD=

# Encrypts stored signer material at rest. 32 random bytes, base64.
#   openssl rand -base64 32
# Losing or changing this makes previously encrypted material unrecoverable.
FACILITATOR_KEY_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database (defaults are fine)
# ---------------------------------------------------------------------------
POSTGRES_DB=openx402
POSTGRES_USER=openx402

# ---------------------------------------------------------------------------
# Ports on the host
# ---------------------------------------------------------------------------
FACILITATOR_PORT=4022
MCP_PORT=4522

# ---------------------------------------------------------------------------
# Search profile
# ---------------------------------------------------------------------------
# config/self-hosted.yaml  -> local embeddings (BAAI/bge-m3), no external calls
# config/railway.yaml      -> remote embeddings, requires the two vars below
FACILITATOR_CONFIG=config/self-hosted.yaml
MCP_SERVER_CONFIG=config/self-hosted.yaml

# Only used when the selected config sets `provider: remote`.
# Any OpenAI-compatible embeddings endpoint works.
#   FACILITATOR_EMBEDDING_URL=https://openrouter.ai/api/v1/embeddings
FACILITATOR_EMBEDDING_URL=
FACILITATOR_EMBEDDING_API_KEY=

# Optional cross-encoder reranking. Off by default — no ONNX export of
# BAAI/bge-reranker-v2-m3 is published for the local runtime.
FACILITATOR_RERANKER_URL=
FACILITATOR_RERANKER_API_KEY=

# ---------------------------------------------------------------------------
# Access control (optional)
# ---------------------------------------------------------------------------
# Comma-separated bearer tokens. Empty = public read access, which is the
# intended default for a discovery service.
FACILITATOR_API_KEYS=
MCP_SERVER_API_KEYS=

# Signs pagination cursors. Generated at boot if unset; set it to keep cursors
# valid across restarts.
FACILITATOR_CURSOR_HMAC_KEY=

# ---------------------------------------------------------------------------
# Settlement (optional — leave unset for discovery-only)
# ---------------------------------------------------------------------------
# Without these the facilitator verifies and catalogs but never settles, and
# the MCP server exposes search/get-resource only.
STELLAR_TESTNET_SPONSOR_SECRET=
STELLAR_PUBNET_SPONSOR_SECRET=

# Paid MCP tool execution. Unset = discovery-only.
MCP_SIGNER_ENCRYPTION_KEY=
STELLAR_SECRET_KEY=
